#!/usr/bin/env bash
# codex worker-binary wrapper. The codex *binary* is @openai/codex, provisioned
# by scripts/bootstrap.sh; its exact path is written to runtime/runtime.env as
# CGM_NODE / CGM_CODEX_JS. This wrapper keeps a single codex version on the
# workers' PATH regardless of where it landed.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../scripts/env.sh" >/dev/null 2>&1
if [ -z "${CGM_NODE:-}" ] || [ -z "${CGM_CODEX_JS:-}" ]; then
  echo "codex not provisioned — run scripts/bootstrap.sh (sets CGM_NODE/CGM_CODEX_JS)" >&2
  exit 127
fi
exec "$CGM_NODE" "$CGM_CODEX_JS" "$@"
