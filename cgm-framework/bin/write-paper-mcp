#!/usr/bin/env bash
# write-paper-mcp — launches the write-paper MCP service (role=main)
# for Claude Code (.mcp.json) or any MCP client. Sources env so CGM_AGENTS_ROOT
# etc. are set, and exports CGM_WRITE_PAPER_SKILL_DIR so the assembler finds the
# operator-editable fixed files (role prompts / style / boilerplate).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../scripts/env.sh" >/dev/null 2>&1
export CGM_ROLE="${CGM_ROLE:-main}"
export CGM_AUTHOR="${CGM_AUTHOR:-main_agent}"
export CGM_WRITE_PAPER_SKILL_DIR="${CGM_WRITE_PAPER_SKILL_DIR:-$CGM_ROOT/agents/skills/write-paper}"
exec "$CGM_PY" -m cgm.write_paper "$@"
