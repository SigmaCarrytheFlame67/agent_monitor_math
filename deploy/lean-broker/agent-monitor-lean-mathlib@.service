[Unit]
Description=Agent Monitor fixed Lean Mathlib broker worker
Documentation=file:/usr/share/doc/agent-monitor-lean-broker/README.md

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/agent-monitor/lean-broker/mathlib.env
ExecStart=/usr/libexec/agent-monitor-lean-broker --profile=mathlib
StandardInput=socket
StandardOutput=socket
StandardError=journal
WorkingDirectory=/tmp
UMask=0077

NoNewPrivileges=yes
PrivateNetwork=yes
PrivatePIDs=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/run
ReadOnlyPaths=/opt/agent-monitor-lean
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=none
SystemCallFilter=~@network-io
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# The whole `import Mathlib` maps ~4.4 GiB of prebuilt .olean data (measured
# with Lean 4.14.0 / Mathlib v4.14.0); 8 GiB leaves headroom for elaboration.
MemoryMax=8589934592
MemorySwapMax=0
TasksMax=128
LimitCORE=0
LimitFSIZE=2097152
LimitNOFILE=64
LimitNPROC=128
RuntimeMaxSec=100s
TimeoutStartSec=100s
TimeoutStopSec=2s
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=kill
