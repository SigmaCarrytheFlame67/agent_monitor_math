# Optional live status overlay for https://ansatze.ai/research/problem-status.json
# (installed by install.sh --with-problem-status together with
# ansatze-problems.timer).
#
# Publishes /var/lib/ansatze-problems/problem-status.json, which Caddy serves in
# place of the empty overlay bundled with the docs build.  Categories change
# only on deterministic source signals; Kimi K3 matches (through the loopback
# sponsored broker, capped by ANSATZE_PROBLEMS_MODEL_CALLS_PER_DAY) only label
# unreviewed reports.  This unit never receives a provider key.
[Unit]
Description=Ansätze problem-status refresh
Documentation=file:/home/ubuntu/Ansatze/deploy/ansatze/README.md
After=network-online.target ansatze-kimi.service
Wants=network-online.target

[Service]
Type=oneshot
User=ansatze-problems
Group=ansatze-problems
StateDirectory=ansatze-problems
# Caddy (user caddy) must be able to read problem-status.json; state.json stays 0600.
StateDirectoryMode=0755
UMask=0022
WorkingDirectory=/var/lib/ansatze-problems
ExecStart=/home/ubuntu/Ansatze/.venv/bin/python /home/ubuntu/Ansatze/scripts/update_problem_status.py --output /var/lib/ansatze-problems/problem-status.json --state /var/lib/ansatze-problems/state.json --news /var/lib/ansatze-news/news.json
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/ansatze-problems
Environment=AGENT_MONITOR_DATA_DIR=/var/lib/ansatze-problems/agent-monitor
Environment=AGENT_MONITOR_ENV_PATH=/dev/null
Environment=AGENT_MONITOR_SPONSORED_KIMI=1
Environment=AGENT_MONITOR_SPONSORED_KIMI_URL=http://127.0.0.1:4610
TimeoutStartSec=20min

ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/Ansatze
BindReadOnlyPaths=/home/ubuntu/.local/share/uv/python/cpython-3.13-linux-x86_64-gnu
InaccessiblePaths=-/home/ubuntu/Ansatze/.env -/home/ubuntu/Ansatze/.secrets -/home/ubuntu/Ansatze/data -/var/lib/ansatze

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @debug @raw-io
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=32
# Parsing a new Kourovka PDF edition with pypdf needs more than the news worker.
MemoryMax=768M
LimitCORE=0
