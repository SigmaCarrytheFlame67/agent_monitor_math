# Sponsored Kimi broker for ansatze.ai (template; install.sh installs it as
# /etc/systemd/system/ansatze-kimi.service).
#
# The only holder of the upstream Kimi key.  It listens on 127.0.0.1:4610 and
# is never routed by Caddy.  The console obtains short-lived loopback proxy
# tokens from POST /internal/sessions; the key itself arrives only through
# LoadCredential= and never enters the console's environment.
#
# Checkout-based: the code and virtualenv come from the ubuntu-owned checkout,
# bind-mounted read-only into an otherwise empty /home.  Anyone who can write
# that checkout can change what this service executes; the immutable-release
# alternative is deploy/public-kimi/.  See deploy/ansatze/README.md.
[Unit]
Description=Ansätze sponsored Kimi broker (loopback 127.0.0.1:4610)
Documentation=file:/home/ubuntu/Ansatze/deploy/ansatze/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ansatze-kimi
Group=ansatze-kimi
StateDirectory=ansatze/kimi
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ansatze/kimi
UMask=0077
ExecStart=/home/ubuntu/Ansatze/.venv/bin/python -m agent_monitor.public_kimi_server
Environment=PYTHONPATH=/home/ubuntu/Ansatze
# Line-buffered journald output (stdout is a socket under systemd).
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/ansatze/kimi
# public_kimi_server refuses to start unless both name the same directory and
# it is not the checkout's data/.
Environment=AGENT_MONITOR_DATA_DIR=/var/lib/ansatze/kimi
Environment=PUBLIC_KIMI_DATA_DIR=/var/lib/ansatze/kimi
Environment=PUBLIC_KIMI_HOST=127.0.0.1
Environment=PUBLIC_KIMI_PORT=4610
Environment=PUBLIC_KIMI_COOKIE_SECURE=1
Environment=AGENT_MONITOR_PUBLIC_KIMI=1
Environment=AGENT_MONITOR_DISABLE_AUTO_PIPELINE=1
Environment=AGENT_MONITOR_ENV_PATH=/dev/null
# Optional operator limits, e.g. PUBLIC_KIMI_GATEWAY_CALLS_PER_HOUR=900.
# Every value is bounded by agent_monitor.public_kimi_server.PublicLimits.
EnvironmentFile=-/etc/ansatze/kimi-limits.env
LoadCredential=kimi_api_key:/etc/ansatze/credentials/kimi_api_key
LoadCredential=kimi_api_base:/etc/ansatze/credentials/kimi_api_base

# Only the checkout and its Python interpreter are visible under /home.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/Ansatze
BindReadOnlyPaths=/home/ubuntu/.local/share/uv/python/cpython-3.13-linux-x86_64-gnu
InaccessiblePaths=-/home/ubuntu/Ansatze/.env -/home/ubuntu/Ansatze/.secrets -/home/ubuntu/Ansatze/data -/var/lib/ansatze/console

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
# User namespaces are restricted on this host; the other mount, process,
# capability and system-call restrictions stay enabled.
PrivateUsers=no
PrivatePIDs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @debug @raw-io
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

TasksMax=128
LimitNOFILE=1024
LimitCORE=0
MemoryMax=2G
MemorySwapMax=0
CPUQuota=200%
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
