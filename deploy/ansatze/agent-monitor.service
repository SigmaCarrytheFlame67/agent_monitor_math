# Ansätze proving console behind Caddy (template; install.sh renders it into
# /etc/systemd/system/agent-monitor.service, replacing the MOUNT token).
#
# Keep this exact unit name: deploy/lean-broker/install.sh stages its client
# drop-in at /etc/systemd/system/agent-monitor.service.d/lean-broker.conf.
#
# The console runs as the host account that owns the checkout and the
# Codex/Claude/Lean command-line tools, so ProtectHome= must stay unset.  The
# console holds no provider key of its own: Kimi comes only from the loopback
# sponsored broker (ansatze-kimi.service), and per-user keys are encrypted in
# users.db with the agent_monitor_data_key credential.
[Unit]
Description=Ansätze proving console (agent_monitor.console_server)
Documentation=file:/home/repo/agent_monitor_math/deploy/ansatze/README.md
After=network-online.target ansatze-kimi.service
Wants=network-online.target ansatze-kimi.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/repo/agent_monitor_math
ExecStart=/home/repo/agent_monitor_math/.venv/bin/python -m agent_monitor.console_server
Environment=PYTHONPATH=/home/repo/agent_monitor_math
# stdout/stderr are journald sockets: without this Python block-buffers the
# access log (minutes late, out of order with stderr, lost on every stop).
Environment=PYTHONUNBUFFERED=1
# ~/.npm-global/bin comes first: it holds the exactly pinned, vetted Codex
# build (npm i -g --prefix ~/.npm-global @openai/codex@0.160.0).  The
# standalone ~/.local/bin/codex can self-update past the pin, and an unvetted
# build makes every Codex response-only route fail closed.
Environment=PATH=/home/ubuntu/.npm-global/bin:/home/ubuntu/.local/node24/bin:/home/ubuntu/.elan/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AGENT_MONITOR_DATA_DIR=/var/lib/ansatze/console
Environment=AGENT_MONITOR_ENV_PATH=/etc/ansatze/console.env
Environment=AGENT_MONITOR_HOST=127.0.0.1
Environment=AGENT_MONITOR_PORT=4600
Environment=AGENT_MONITOR_BASE_PATH=@@MOUNT@@
Environment=AGENT_MONITOR_APP_URL=https://ansatze.ai
# PUBLIC=1 would redirect /login to / and break the docs /sign-in contract;
# guests use the explicit "Continue as guest" path instead.
Environment=AGENT_MONITOR_PUBLIC=0
Environment=AGENT_MONITOR_GUEST_ACCESS=1
Environment=AGENT_MONITOR_SPONSORED_KIMI=1
Environment=AGENT_MONITOR_SPONSORED_KIMI_URL=http://127.0.0.1:4610
# Finished anonymous guest runs (records and workspaces) are deleted by the
# console itself after this many days; usage history is kept.
Environment=AGENT_MONITOR_GUEST_RUN_RETENTION_DAYS=30
# The console opens users.db at startup and exits when the per-user settings
# key is missing, unreadable or invalid, or cannot authenticate stored
# settings (LoadCredential already fails the start when the credential file
# is absent).  Server-level settings are never written from the web UI
# (console.env is root-managed).
Environment=AGENT_MONITOR_REQUIRE_DATA_KEY=1
Environment=AGENT_MONITOR_SERVER_SETTINGS_READ_ONLY=1
LoadCredential=agent_monitor_data_key:/etc/ansatze/credentials/agent_monitor_data_key
# AGENT_MONITOR_REGISTRATION_OPEN is unset (closed) in this template; ansatze.ai
# opens it with a drop-in.  Members stay on the tool-free engines enforced by
# agent_monitor/account_policy.py; see "Registration and what members can do"
# in deploy/ansatze/README.md.

Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
LimitCORE=0
# Ceilings for the whole unit (the console, its request threads and the local
# harness processes it starts): many large or stalled uploads, or a runaway
# harness, hit these instead of the host's memory and PID space.
MemoryHigh=10G
MemoryMax=12G
TasksMax=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Local harnesses run as this account; keep the Kimi broker's state and the
# root-held credential sources out of their view as well.  NoNewPrivileges
# does not cover a process that the ubuntu *user manager* starts (for example
# `systemd-run --user sudo ...` over /run/user/1000/bus), which runs outside
# this unit, so the per-user runtime directories are hidden too; the Codex and
# Claude CLIs need no user bus.
# The host account's own Claude Code and Codex state is hidden as well: its
# transcripts and logins (~/.claude, ~/.claude.json, ~/.codex) can hold
# pasted secrets and the operator's subscriptions.  Console runs never need
# them: every Claude/Codex route gets an isolated CLAUDE_CONFIG_DIR or
# CODEX_HOME under /var/lib/ansatze/console.
InaccessiblePaths=-/var/lib/ansatze/kimi -/etc/ansatze/credentials -/home/repo/agent_monitor_math/.secrets -/run/user -/home/ubuntu/.claude -/home/ubuntu/.claude.json -/home/ubuntu/.codex

[Install]
WantedBy=multi-user.target
