# ── LLM providers (LiteLLM-compatible env vars) ─────────────────────────────
# For local development, copy this template to `.env` and edit that copy.
# Production (https://ansatze.ai) does not read this file or the checkout's
# .env: deploy/ansatze/ installs /etc/ansatze/console.env (no provider keys),
# root-only systemd credentials, and the loopback sponsored Kimi broker.

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi K3 — OpenAI-compatible Chat Completions. Development only: a console
# env that holds KIMI_API_KEY hands the raw key to guest runs. In production
# the key lives only in ansatze-kimi.service (LoadCredential=kimi_api_key).
KIMI_API_KEY=
# KIMI_API_BASE=https://2qg3r7w8aefiukbds.flashflame.ai/v1
# KIMI_REASONING_EFFORT=max

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
XAI_API_KEY=

# ── Defaults ────────────────────────────────────────────────────────────────
AGENT_MONITOR_MODEL=gpt-5.6-sol
# HERMES_MODEL=
# AGENT_MONITOR_BASE_URL=
# AGENT_MONITOR_MAX_ITERATIONS=40
# Default wall-clock limit for CLI engines; individual engines may override it.
# AGENT_MONITOR_CLI_TIMEOUT=3600
# Full file-backed DeepAgents audits default to three hours unless overridden.
# AGENT_MONITOR_DEEPAGENTS_TIMEOUT=10800

# ── Service ───────────────────────────────────────────────────────────────
# The production values live in deploy/ansatze/agent-monitor.service.
# AGENT_MONITOR_PORT=4600
# The server, start.sh and the production unit all bind loopback by default;
# Caddy terminates public HTTPS. Set 0.0.0.0 only deliberately.
# AGENT_MONITOR_HOST=127.0.0.1
# Console mount behind the proxy (production: a random /proof-<40 hex>;
# https://ansatze.ai/sign-in redirects to <mount>/login).
# AGENT_MONITOR_BASE_PATH=/proof-0123456789abcdef0123456789abcdef01234567
# Public origin used in password-reset links (the mount is appended).
# AGENT_MONITOR_APP_URL=https://ansatze.ai
# Include Kimi through the isolated loopback broker (agent_monitor.public_kimi_server)
# instead of a key in this environment.
# AGENT_MONITOR_SPONSORED_KIMI=1
# AGENT_MONITOR_SPONSORED_KIMI_URL=http://127.0.0.1:4610
# Operator-only Kimi endpoint for non-sponsored Kimi engine runs (a visitor's
# or account's own key). Must be credential-free HTTPS; defaults to the
# built-in Kimi K3 base. Account-level KIMI_API_BASE values never apply there.
# AGENT_MONITOR_KIMI_BASE_URL=https://2qg3r7w8aefiukbds.flashflame.ai/v1
# Per-user settings (saved keys, Codex/Claude runtime) are encrypted with a
# Fernet key. Production passes it as the systemd credential
# agent_monitor_data_key; for development point at a 0600 file instead.
# Without a key, saving Settings fails. With REQUIRE_DATA_KEY=1 the console
# opens users.db at startup and exits if the key is missing, invalid, or cannot
# authenticate stored settings.
# AGENT_MONITOR_DATA_KEY_FILE=/path/to/agent_monitor_data_key
# AGENT_MONITOR_REQUIRE_DATA_KEY=1
# Refuse server-level writes from the web UI (production console.env is root-managed).
# AGENT_MONITOR_SERVER_SETTINGS_READ_ONLY=1
# Mathlib project for the Library "lean-check" tool only. Formal verification
# always uses the sandboxed Lean broker and never this path.
# AGENT_MONITOR_MATHLIB_PROJECT=/home/ubuntu/.cache/agent-monitor/mathlib-v4.14.0
# Offer a restricted, cookie-scoped "Continue as guest" path (enabled by default).
# AGENT_MONITOR_GUEST_ACCESS=0
# Guests (and new accounts) default to `kimi`: Ansatz CGM · Kimi K3, the
# tool-free CGM pipeline (guest budget: 12 model calls, 2 workers, 1 repair,
# 2400 s, 8192 output tokens per call). The eligible guest engines are `kimi`
# and `plain`; Claude Code and Codex require sign-in.
# AGENT_MONITOR_GUEST_ENGINES=kimi,plain
# Hosted guests use the sponsored broker (AGENT_MONITOR_SPONSORED_KIMI=1).
# Development fallback only: a dedicated key for hosted guest Kimi runs;
# otherwise KIMI_API_KEY is used. Never set either on ansatze.ai.
# Without any hosted route, guests can add their own Kimi key in Settings.
# AGENT_MONITOR_GUEST_KIMI_API_KEY=
# AGENT_MONITOR_GUEST_MAX_ITERATIONS=8
# Plain only; CGM (`kimi`) calls always use the bounded 8192-token ceiling.
# AGENT_MONITOR_GUEST_MAX_OUTPUT_TOKENS=4096
# AGENT_MONITOR_GUEST_CONCURRENCY=1
# AGENT_MONITOR_GUEST_GLOBAL_CONCURRENCY=2
# Total guest run starts, capped at 10. Deleting runs does not restore the allowance.
# After the allowance is used, the visitor must sign in to start more runs.
# AGENT_MONITOR_GUEST_RUNS_PER_SESSION=10
# AGENT_MONITOR_GUEST_RUNS_PER_HOUR=6
# AGENT_MONITOR_GUEST_GLOBAL_RUNS_PER_HOUR=30
# AGENT_MONITOR_GUEST_VERIFICATIONS_PER_HOUR=6
# AGENT_MONITOR_GUEST_GLOBAL_VERIFICATIONS_PER_HOUR=60
# AGENT_MONITOR_GUEST_VERIFY_GLOBAL_CONCURRENCY=4
# Manual guest Formal/Lean and DAG actions (Verify, Compile, Check, Audit,
# feedback, model-backed DAG refresh; at most 4 Lean repair rounds for
# Verify/generation and 1 for a feedback revision). Starting the automatic
# views when a guest proof finishes counts as one action. One action at a time
# per guest; limits answer HTTP 429 (409 while the automatic views still run)
# with Retry-After. The formal DAG refresh a Lean action starts in the
# background keeps that action's slot until its model call ends, so the
# concurrency limit covers it. Reading results, the Lean toolchain status and
# the model-free Informal · CGM view is free. Ranges: 1-60, 1-480, 1-8.
# AGENT_MONITOR_GUEST_DERIVED_ACTIONS_PER_HOUR=24
# AGENT_MONITOR_GUEST_DERIVED_GLOBAL_ACTIONS_PER_HOUR=120
# AGENT_MONITOR_GUEST_DERIVED_GLOBAL_CONCURRENCY=2
# AGENT_MONITOR_GUEST_SESSIONS_PER_MINUTE=10
# Per-client guest limits, on top of the per-guest and site-wide ones, so one
# visitor minting many guest identities cannot use up everyone's allowance.
# The client is the address the reverse proxy (Caddy) forwards in
# X-Forwarded-For, or a direct remote peer; IPv6 is grouped by /64; processes
# on this host are exempt. Ranges: 1-120, 1-240, 1-16, 1-480.
# AGENT_MONITOR_GUEST_SESSIONS_PER_CLIENT_PER_HOUR=6
# AGENT_MONITOR_GUEST_RUNS_PER_CLIENT_PER_HOUR=12
# AGENT_MONITOR_GUEST_CLIENT_CONCURRENCY=1
# AGENT_MONITOR_GUEST_DERIVED_ACTIONS_PER_CLIENT_PER_HOUR=48
# Delete finished guest runs (records and workspaces; usage history is kept)
# this many days after they end. 0 (the default) keeps them; the ansatze.ai
# unit sets 30. Guests may attach at most 2 text files, 64 KB in total.
# AGENT_MONITOR_GUEST_RUN_RETENTION_DAYS=0
# PLAIN_CMD or KIMI_PROOF_CMD disables that engine for guests because command
# overrides are outside the built-in tool-free execution contract.
# Self-registration is closed unless an operator explicitly opens it. Enable
# only for a controlled enrollment window; local harnesses are not a sandbox.
# Create the first admin without opening it: `agent-monitor create-admin`.
# AGENT_MONITOR_REGISTRATION_OPEN=1
# Limit self-registration (password and Google) to these address suffixes,
# comma-separated; accounts created before the limit keep working.
# AGENT_MONITOR_REGISTRATION_EMAIL_SUFFIXES=.edu
# Require new accounts to confirm their address with an emailed link before
# they can sign in. Needs the SMTP settings below; Google sign-ups count as
# confirmed.
# AGENT_MONITOR_REQUIRE_EMAIL_VERIFICATION=1
# Open to anyone: skip the choice screen and issue a guest session per visitor.
# Keep this off on ansatze.ai: it gives every account the server's keys and
# redirects /login away, which breaks the docs /sign-in contract.
# AGENT_MONITOR_PUBLIC=1

# ── Ansatz CGM pipeline (engines `kimi` and `math_harness`) ───────────────
# Budgets for signed-in API-key runs (defaults shown; clamped to ceilings of
# 64 calls, 3 workers, 4 repairs, 3 candidates, 16 lemmas, 14400 s). Guest,
# public and sponsored runs always use the guest profile (12 calls, 2 workers,
# 1 repair, 2 candidates, 6 lemmas, 2400 s); these values can only lower it.
# See OPERATIONS.md "Ansatz CGM runs" (also: receipt schema versions).
# AGENT_MONITOR_CGM_MAX_CALLS=16
# AGENT_MONITOR_CGM_MAX_WORKERS=3
# AGENT_MONITOR_CGM_MAX_REPAIRS=2
# AGENT_MONITOR_CGM_MAX_VERIFY_CANDIDATES=2
# AGENT_MONITOR_CGM_MAX_LEMMAS=8
# AGENT_MONITOR_CGM_MAX_SECONDS=5400
# Provider calls in flight, 1-6. Unset: 3 on API routes, 1 on Codex/Claude
# subscription routes; guest, public and sponsored runs use 2 (their ceiling).
# AGENT_MONITOR_CGM_CONCURRENCY=3
# Per-call total timeout on API routes, 60-900 s: 300 by default, 630 on a
# sponsored Kimi run. A sponsored call also sends it to the broker as
# X-Ansatze-Timeout, so a lower value shortens the broker's and gateway's
# deadlines for that call too.
# AGENT_MONITOR_CGM_API_TIMEOUT=300
# Kimi reasoning effort (low, high or max) for every stage except the curator.
# AGENT_MONITOR_CGM_REASONING_EFFORT=

# ── Analyze (engine `analyze`; agent_monitor/runners/analyze_runner.py) ─────
# Kill switches: Analyze as a whole (default on; 0 hides the mode and refuses
# it for everyone) and for anonymous guests (default on, within the guest
# caps and one analysis per guest per hour; 0 refuses guests). An ANALYZE_CMD
# override removes Analyze from guests and members.
# AGENT_MONITOR_ANALYZE_ENABLED=1
# AGENT_MONITOR_ANALYZE_GUESTS=1
# Sponsored Kimi K3 analyses (and re-checks): a site-wide daily cap (UTC
# days, counted in $AGENT_MONITOR_DATA_DIR/analyze_sponsored_usage.json; 0
# turns sponsored Analyze off, own-key analyses keep working) and how many may
# run at once (1-8).
# AGENT_MONITOR_ANALYZE_SPONSORED_RUNS_PER_DAY=40
# AGENT_MONITOR_ANALYZE_SPONSORED_CONCURRENCY=2
# The guests' share of that pool: daily runs (default half of the daily cap,
# rounded down, at most the cap; 0 keeps guests off sponsored Analyze) and
# slots held at once (default half of the slots, at least one), so anonymous
# traffic cannot lock members out. A guest also re-checks at most 2 results
# per analysis, 2 per session and 4 per network each hour (fixed).
# AGENT_MONITOR_ANALYZE_GUEST_SPONSORED_RUNS_PER_DAY=20
# AGENT_MONITOR_ANALYZE_GUEST_SPONSORED_CONCURRENCY=1
# Per-role caps: result checks, model calls (retries included) and wall clock.
# Defaults: guest 12/16/2400 s, member sponsored 30/36/3600 s, member own key
# 120/140/3600 s, admin 256/300/14400 s; any value is clamped to 256/300/14400.
# AGENT_MONITOR_ANALYZE_GUEST_MAX_NODES=12
# AGENT_MONITOR_ANALYZE_GUEST_MAX_CALLS=16
# AGENT_MONITOR_ANALYZE_GUEST_MAX_SECONDS=2400
# AGENT_MONITOR_ANALYZE_MEMBER_SPONSORED_MAX_NODES=30
# AGENT_MONITOR_ANALYZE_MEMBER_SPONSORED_MAX_CALLS=36
# AGENT_MONITOR_ANALYZE_MEMBER_SPONSORED_MAX_SECONDS=3600
# AGENT_MONITOR_ANALYZE_MEMBER_OWN_KEY_MAX_NODES=120
# AGENT_MONITOR_ANALYZE_MEMBER_OWN_KEY_MAX_CALLS=140
# AGENT_MONITOR_ANALYZE_MEMBER_OWN_KEY_MAX_SECONDS=3600
# AGENT_MONITOR_ANALYZE_ADMIN_MAX_NODES=256
# AGENT_MONITOR_ANALYZE_ADMIN_MAX_CALLS=300
# AGENT_MONITOR_ANALYZE_ADMIN_MAX_SECONDS=14400
# Checks in flight, 1-3 (sponsored and guest runs at most 2, account
# subscriptions 1).
# AGENT_MONITOR_ANALYZE_CONCURRENCY=3
# Per-call total timeout, 60-900 s (default 300; 630 on sponsored Kimi).
# AGENT_MONITOR_ANALYZE_API_TIMEOUT=300
# Optional GitHub token for folder listings (one git/trees API call per GitHub
# folder; unauthenticated calls are limited to 60 per hour per server). Sent
# only with the connector's own api.github.com calls (never with a link a user
# pasted), never after a redirect, and scrubbed from every other engine's
# environment. Use a fine-grained token limited to public repositories with
# no permissions; never a classic token or one that can read private repos.
# AGENT_MONITOR_ANALYZE_GITHUB_TOKEN=

# ── Sponsored Kimi broker (separate process; production reads these from
# /etc/ansatze/kimi-limits.env). Values are clamped to hard ceilings.
# PUBLIC_KIMI_GATEWAY_CALLS_PER_HOUR=900
# PUBLIC_KIMI_GATEWAY_CONCURRENCY=8
# When every gateway slot is busy, a call waits up to QUEUE_SECONDS for one
# (first come, first served; 0-120, 0 = refuse at once with HTTP 429) while
# fewer than QUEUE_DEPTH calls (0-128) are waiting. The wait is taken from
# the call's own total time, UPSTREAM_TIMEOUT_SECONDS (60-900), after which
# the gateway stops the call and answers HTTP 504.
# PUBLIC_KIMI_GATEWAY_QUEUE_SECONDS=60
# PUBLIC_KIMI_GATEWAY_QUEUE_DEPTH=32
# PUBLIC_KIMI_UPSTREAM_TIMEOUT_SECONDS=600
# PUBLIC_KIMI_MAX_OUTPUT_TOKENS=8192
# PUBLIC_KIMI_SPONSOR_CALLS_PER_TOKEN=200
# PUBLIC_KIMI_SPONSOR_STARTS_PER_HOUR=60
# PUBLIC_KIMI_SPONSOR_TOKENS_PER_CLIENT=64

# ── News feed worker (scripts/update_math_news.py) ──────────────────────────
# The worker reads no .env file: export this for a local run, or set it in the
# unit (`systemctl edit ansatze-news.service`) in production. Kimi K3 calls
# per UTC day for summaries, triage, story grouping and problem links, counted
# in the worker's state file (at most 4 per run unless --max-model-calls says
# otherwise). 0 turns the model off; cards then show headlines and quoted
# source excerpts only.
# ANSATZE_NEWS_MODEL_CALLS_PER_DAY=60

# ── Problem-status updater (ansatze-problems.service, not the console) ──────
# Read by scripts/update_problem_status.py; set it in the unit with
# `systemctl edit ansatze-problems.service` (Environment=...).  Kimi K3 calls per
# UTC day for matching new reports to problems (default 48; 0 disables model
# calls; at most 8 per six-hourly run).  The count persists in the updater's
# state.json, independent of the broker's in-memory limits.
# ANSATZE_PROBLEMS_MODEL_CALLS_PER_DAY=48

# ── Outgoing email: password-reset and confirmation links (optional) ────────
# Any provider with authenticated STARTTLS on port 587 works (Amazon SES,
# Resend, Postmark, SendGrid, Gmail with an app password). Without these,
# the sign-in page says that reset by email is unavailable, and
# `agent-monitor set-password` is the operator's fallback.
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# ── Sign in with Google (optional) ──────────────────────────────────────────
# OAuth "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin must include your site (e.g. https://ansatze.ai)
# GOOGLE_OAUTH_CLIENT_ID=

# ── Engine paths (optional) ─────────────────────────────────────────────────
# UCLA_HARNESS_ROOT=
# IMPROOF_ROOT=
# Codex response-only routes (Plain, Math Harness, derived Lean/DAG calls on a
# Codex subscription) accept exactly codex-cli 0.153.4 or 0.157.1 and fail
# closed on any other build. Install the pin user-level and keep
# ~/.npm-global/bin first on PATH (OPERATIONS.md "Codex vetting"):
#   npm i -g --prefix ~/.npm-global @openai/codex@0.157.1
# CODEX_CMD=
# OPENCLAUDE_CMD=
# OPENHANDS_CMD=
